# Example environment variables for Task API
# Copy this file to .env for local development:
# cp .env.example .env

# Database Connection URL
# Local host connection: postgres://postgres:dev@localhost:5432/tasks
# Docker Compose connection: postgres://postgres:dev@db:5432/tasks
DATABASE_URL=postgres://postgres:dev@localhost:5432/tasks

# Supabase Auth Configuration (A4)
# Get these from: https://supabase.com/dashboard → Project Settings → API
# SUPABASE_KEY MUST be the anon/public key. NEVER use service_role.
SUPABASE_URL=your_project_url
SUPABASE_KEY=your_anon_key

# Server port (used by Docker)
PORT=3000
